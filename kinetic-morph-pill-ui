<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horizon OS — Kinetic Morph Pill Window Control</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <style>
        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            user-select: none;
            -webkit-user-select: none;
        }
        .mono {
            font-family: 'JetBrains Mono', monospace;
        }

        /* Custom Wallpaper Mesh Gradient */
        .os-wallpaper {
            background-color: #07090e;
            background-image: 
                radial-gradient(at 15% 15%, rgba(56, 189, 248, 0.16) 0px, transparent 45%),
                radial-gradient(at 85% 20%, rgba(139, 92, 246, 0.16) 0px, transparent 50%),
                radial-gradient(at 50% 85%, rgba(244, 63, 94, 0.11) 0px, transparent 50%),
                radial-gradient(at 80% 80%, rgba(16, 185, 129, 0.08) 0px, transparent 40%);
        }

        /* Smooth Window Physics Transitions */
        .os-window {
            transition: 
                width 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                height 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                top 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                left 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.3s ease,
                border-radius 0.35s ease;
            will-change: width, height, top, left, transform, opacity;
        }

        .os-window.dragging-pill {
            transition: transform 0.08s ease-out !important;
        }

        /* Kinetic Morph Pill Styles */
        .horizon-pill-wrapper {
            padding: 6px 4px;
            cursor: grab;
        }
        .horizon-pill-wrapper:active {
            cursor: grabbing;
        }

        .horizon-pill {
            width: 56px;
            height: 12px;
            border-radius: 9999px;
            transition: 
                width 0.36s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.36s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.25s ease,
                box-shadow 0.35s ease,
                transform 0.2s ease,
                border-color 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        /* Expanded Wake-up State on Proximity/Hover or Drag */
        .horizon-pill-wrapper:hover .horizon-pill,
        .horizon-pill.pill-active {
            width: 198px;
            height: 30px;
        }

        .pill-segments {
            opacity: 0;
            transform: scale(0.92);
            transition: opacity 0.22s ease 0.04s, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
        }

        .horizon-pill-wrapper:hover .pill-segments,
        .horizon-pill.pill-active .pill-segments {
            opacity: 1;
            transform: scale(1);
            pointer-events: auto;
        }

        /* Status Aura Glow Variations */
        .aura-idle {
            background: rgba(255, 255, 255, 0.18);
            border: 1px solid rgba(255, 255, 255, 0.38);
            box-shadow: 0 0 14px rgba(255, 255, 255, 0.18), inset 0 1px 1px rgba(255, 255, 255, 0.35);
        }
        .horizon-pill-wrapper:hover .aura-idle {
            background: rgba(15, 23, 42, 0.88);
            border-color: rgba(255, 255, 255, 0.45);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5), 0 0 18px rgba(255, 255, 255, 0.2);
        }

        .aura-unsaved {
            background: rgba(245, 158, 11, 0.32);
            border: 1px solid rgba(251, 191, 36, 0.85);
            box-shadow: 0 0 18px rgba(245, 158, 11, 0.55), inset 0 1px 2px rgba(254, 243, 199, 0.5);
            animation: amberBreath 2.4s infinite ease-in-out;
        }
        .horizon-pill-wrapper:hover .aura-unsaved {
            background: rgba(24, 20, 15, 0.92);
            border-color: rgba(251, 191, 36, 0.9);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6), 0 0 22px rgba(245, 158, 11, 0.5);
        }

        .aura-processing {
            background: rgba(56, 189, 248, 0.32);
            border: 1px solid rgba(56, 189, 248, 0.9);
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.65), inset 0 1px 2px rgba(224, 242, 254, 0.6);
            animation: bluePulse 1.6s infinite ease-in-out;
        }
        .horizon-pill-wrapper:hover .aura-processing {
            background: rgba(12, 22, 38, 0.92);
            border-color: rgba(56, 189, 248, 0.95);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6), 0 0 24px rgba(56, 189, 248, 0.55);
        }

        @keyframes amberBreath {
            0%, 100% { box-shadow: 0 0 12px rgba(245, 158, 11, 0.45); }
            50% { box-shadow: 0 0 24px rgba(245, 158, 11, 0.85); }
        }

        @keyframes bluePulse {
            0%, 100% { box-shadow: 0 0 14px rgba(56, 189, 248, 0.45); }
            50% { box-shadow: 0 0 26px rgba(56, 189, 248, 0.95); }
        }

        /* SVG Countdown Circle Animation */
        .countdown-ring-circle {
            transition: stroke-dashoffset 0.1s linear;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 9999px;
        }
    </style>
</head>
<body class="os-wallpaper h-screen w-screen overflow-hidden flex flex-col justify-between relative text-slate-100 select-none">

    <!-- TOP SYSTEM MENU BAR -->
    <header class="h-8 w-full bg-slate-950/60 backdrop-blur-md border-b border-white/10 px-4 flex items-center justify-between z-40 text-xs">
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-1.5 font-semibold text-white">
                <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-tr from-sky-400 to-indigo-500 inline-block"></span>
                <span>Horizon OS</span>
            </div>
            <span class="text-slate-400 hidden sm:inline">Studio Workspace</span>
            <span id="top-bar-mode-badge" class="px-2 py-0.5 rounded-full bg-white/10 text-[11px] text-slate-200 font-medium">
                State: Centered Window
            </span>
        </div>

        <!-- Gesture Telemetry Pill in Top Bar -->
        <div id="gesture-feedback-banner" class="hidden md:flex items-center gap-2 text-[11px] text-sky-300 bg-sky-500/10 border border-sky-400/20 px-3 py-0.5 rounded-full">
            <i class="ph-fill ph-hand-swipe-right"></i>
            <span id="gesture-telemetry-text">Hover or drag the corner Horizon Pill to control window</span>
        </div>

        <div class="flex items-center gap-3 text-slate-300">
            <div class="flex items-center gap-1.5">
                <span id="aura-top-dot" class="w-2 h-2 rounded-full bg-white"></span>
                <span id="aura-top-label" class="text-[11px] text-slate-300">Aura: Idle</span>
            </div>
            <span class="text-white/20">|</span>
            <span id="system-clock" class="mono text-[11px]">09:41 AM</span>
        </div>
    </header>

    <!-- DESKTOP STAGE AREA -->
    <main id="desktop-stage" class="relative flex-1 w-full h-full overflow-hidden">

        <!-- SNAP ZONE PREVIEW OVERLAY (Shown when dragging Left/Right/Up/Down) -->
        <div id="snap-preview-overlay" class="pointer-events-none absolute opacity-0 transition-all duration-200 z-20 rounded-2xl border-2 border-sky-400/70 bg-sky-500/15 backdrop-blur-[2px] flex items-center justify-center">
            <div class="px-4 py-2 rounded-xl bg-slate-900/90 border border-sky-400/40 text-sky-200 text-xs font-semibold tracking-wide flex items-center gap-2 shadow-2xl">
                <i id="snap-preview-icon" class="ph-bold ph-arrows-out text-base"></i>
                <span id="snap-preview-label">Release to Snap</span>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- 1. THE MAIN APPLICATION WINDOW WITH KINETIC MORPH PILL         -->
        <!-- ============================================================== -->
        <section id="app-window" class="os-window absolute z-30 bg-slate-900/85 backdrop-blur-2xl border border-white/15 shadow-[0_25px_70px_-15px_rgba(0,0,0,0.85)] flex flex-col overflow-hidden"
            style="width: 780px; height: 500px; top: calc(50% - 260px); left: calc(50% - 470px); border-radius: 18px;">

            <!-- WINDOW HEADER BAR featuring the CORNER KINETIC MORPH PILL -->
            <div id="window-titlebar" class="relative h-12 w-full bg-slate-950/50 border-b border-white/10 px-4 flex items-center justify-between shrink-0 transition-all duration-300">
                
                <!-- App Identity & Quick Corner Toggle Cluster -->
                <div id="titlebar-info-cluster" class="flex items-center gap-3">
                    <div class="flex items-center gap-2.5">
                        <div class="w-6 h-6 rounded-lg bg-gradient-to-br from-sky-500 to-indigo-600 flex items-center justify-center shadow-inner">
                            <i class="ph-bold ph-cube-transparent text-white text-xs"></i>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-semibold text-white tracking-tight">Nova Studio Pro</span>
                            <span id="unsaved-badge" class="hidden px-1.5 py-0.2 bg-amber-500/20 border border-amber-400/40 text-amber-300 rounded text-[10px] font-medium">Edited</span>
                            <span id="render-badge" class="hidden px-1.5 py-0.2 bg-sky-500/20 border border-sky-400/40 text-sky-300 rounded text-[10px] font-medium flex items-center gap-1">
                                <i class="ph-bold ph-spinner animate-spin"></i> <span class="render-pct">64%</span>
                            </span>
                        </div>
                    </div>

                    <div class="h-3.5 w-[1px] bg-white/10 hidden sm:block"></div>

                    <!-- Instant Corner Placement Switcher (Top-Left vs Top-Right) -->
                    <div class="hidden sm:flex items-center bg-slate-900/90 p-0.5 rounded-lg border border-white/10 text-[10px]">
                        <button id="corner-btn-left" onclick="setPillCorner('left')" 
                                class="px-2 py-0.5 rounded-md text-slate-400 hover:text-white transition flex items-center gap-1"
                                title="Anchor Horizon Pill to Top-Left Corner (Mac Style)">
                            <i class="ph-bold ph-arrow-up-left"></i> Top-Left
                        </button>
                        <button id="corner-btn-right" onclick="setPillCorner('right')" 
                                class="px-2 py-0.5 rounded-md bg-sky-500/25 text-sky-300 border border-sky-400/30 font-semibold transition flex items-center gap-1"
                                title="Anchor Horizon Pill to Top-Right Corner (Windows Style)">
                            Top-Right <i class="ph-bold ph-arrow-up-right"></i>
                        </button>
                    </div>

                    <span id="window-size-pill" class="hidden md:inline-block px-2 py-0.5 rounded-md bg-white/5 border border-white/10 text-[10px] text-slate-400 mono">
                        Default View
                    </span>
                </div>

                <!-- ========================================================== -->
                <!-- CORNER KINETIC MORPH PILL (EXPANDS INWARD FROM CORNER)     -->
                <!-- ========================================================== -->
                <div id="horizon-pill-wrapper" class="horizon-pill-wrapper relative z-50 flex flex-col items-end group"
                     title="Drag Up: Maximize | Drag Down: Live Pip | Drag Left/Right: Split 50% | Click Red Zone: Close">
                    
                    <div id="horizon-pill" class="horizon-pill aura-idle flex items-center justify-between">
                        
                        <!-- Expanded 3-Zone Interactive Controls (Visible on Proximity Hover / Drag) -->
                        <div id="pill-segments-grid" class="pill-segments w-full h-full grid grid-cols-3 items-center text-[11px] font-medium">
                            
                            <!-- Zone 1: Left / Right Split-Screen Tile -->
                            <div id="pill-zone-tile" class="h-full flex items-center justify-center gap-1 hover:bg-white/10 transition-colors border-r border-white/10 px-1.5"
                                 onclick="event.stopPropagation(); cycleSnapSplit();"
                                 title="Click or Drag Left/Right to Split-Screen 50%">
                                <button onclick="event.stopPropagation(); triggerWindowAction('snap-left')" class="hover:text-sky-300 text-slate-300 p-0.5 rounded transition" title="Snap Left 50%">
                                    <i class="ph-bold ph-caret-left text-xs"></i>
                                </button>
                                <span class="text-[9px] uppercase tracking-wider text-slate-300 font-semibold">Tile</span>
                                <button onclick="event.stopPropagation(); triggerWindowAction('snap-right')" class="hover:text-sky-300 text-slate-300 p-0.5 rounded transition" title="Snap Right 50%">
                                    <i class="ph-bold ph-caret-right text-xs"></i>
                                </button>
                            </div>

                            <!-- Zone 2: Center Morph Zone (Up = Max, Down = Live Pip) -->
                            <div id="pill-zone-morph" class="h-full flex items-center justify-center gap-1.5 hover:bg-white/10 transition-colors border-r border-white/10 px-1.5"
                                 ondblclick="event.stopPropagation(); triggerWindowAction('toggle-maximize');"
                                 title="Flick Up to Maximize, Flick Down for Live Pip">
                                <button onclick="event.stopPropagation(); triggerWindowAction('minimize-pip')" class="hover:text-amber-300 text-slate-300 p-0.5 rounded transition" title="Flick Down: Live Pip Minimize">
                                    <i class="ph-bold ph-arrow-down-left text-xs"></i>
                                </button>
                                <button onclick="event.stopPropagation(); triggerWindowAction('toggle-maximize')" class="hover:text-emerald-300 text-slate-200 p-0.5 rounded transition" title="Flick Up / Double-Click: Fullscreen">
                                    <i class="ph-bold ph-arrows-out-simple text-xs"></i>
                                </button>
                            </div>

                            <!-- Zone 3: Corner Edge Crimson Close Trigger -->
                            <button id="pill-zone-close" onclick="event.stopPropagation(); triggerWindowAction('close-window')" 
                                    class="h-full w-full flex items-center justify-center gap-1 bg-rose-500/20 hover:bg-rose-600 text-rose-200 hover:text-white transition-all duration-150 px-2 group/close"
                                    title="Click or Middle-Click Pill to Close (with 5s Time-Loop Undo)">
                                <span class="text-[10px] font-semibold tracking-tight">Close</span>
                                <i class="ph-bold ph-x text-xs group-hover/close:scale-110 transition-transform"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Micro Direction Hint Label underneath on Hover (Aligned to active corner) -->
                    <div id="pill-micro-tooltip" class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none absolute top-10 right-0 px-2.5 py-1 rounded-full bg-slate-950/95 border border-white/15 text-[10px] text-slate-300 whitespace-nowrap shadow-xl z-50">
                        Drag <span class="text-sky-300">↑ Max</span> · <span class="text-amber-300">↓ Live Pip</span> · <span class="text-indigo-300">↔ Split 50%</span> · <span class="text-rose-400">Corner Click = Close</span>
                    </div>
                </div>
            </div>

            <!-- WINDOW BODY CONTENT -->
            <div class="flex-1 p-5 overflow-y-auto grid grid-cols-1 lg:grid-cols-12 gap-4">
                
                <!-- Left Column: Interactive Concept Sandbox -->
                <div class="lg:col-span-7 flex flex-col justify-between space-y-4">
                    
                    <!-- Hero Explanation Card inside Window -->
                    <div class="p-4 rounded-xl bg-gradient-to-br from-slate-800/80 to-slate-900/90 border border-white/10 shadow-inner">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[11px] font-semibold uppercase tracking-wider text-sky-400 flex items-center gap-1.5">
                                <i class="ph-fill ph-sparkle"></i> Corner-Anchored Kinetic Pill
                            </span>
                            <span id="active-corner-pill-badge" class="text-[11px] text-sky-300 mono bg-sky-500/10 border border-sky-400/20 px-2 py-0.5 rounded">Top-Right Corner</span>
                        </div>
                        <h2 class="text-base font-bold text-white leading-snug">
                            Anchored in the Corner — Expanding Smoothly Inward
                        </h2>
                        <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
                            Move your cursor to the <strong id="hero-corner-text" class="text-white">top-right corner</strong> of this window. The capsule expands inward so it never clips off-screen, keeping the crimson <strong class="text-rose-300">Close</strong> zone pinned right at the outer corner edge for effortless Fitts's Law targeting.
                        </p>

                        <!-- Live Gesture Visualizer Meter -->
                        <div class="mt-3 pt-3 border-t border-white/10 flex items-center justify-between text-xs">
                            <div class="flex items-center gap-2">
                                <span class="text-slate-400">Last Action:</span>
                                <span id="last-action-badge" class="px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 font-medium text-[11px]">
                                    Ready for input
                                </span>
                            </div>
                            <span id="drag-vector-readout" class="mono text-[11px] text-slate-400">Δx: 0px, Δy: 0px</span>
                        </div>
                    </div>

                    <!-- Feature 1: Status Aura Switcher (Directly Changes the Horizon Pill Glow) -->
                    <div class="p-4 rounded-xl bg-slate-950/50 border border-white/10">
                        <div class="flex items-center justify-between mb-2.5">
                            <div>
                                <h3 class="text-xs font-semibold text-white uppercase tracking-wider">1. Test Dynamic Status Aura</h3>
                                <p class="text-[11px] text-slate-400">The pill's border glow communicates window state before you even hover.</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-3 gap-2">
                            <!-- Idle State Button -->
                            <button onclick="setWindowAura('idle')" id="aura-btn-idle"
                                class="aura-mode-btn p-2.5 rounded-lg border border-white/30 bg-white/10 text-left transition flex flex-col justify-between">
                                <div class="flex items-center justify-between">
                                    <span class="w-2.5 h-2.5 rounded-full bg-white shadow-[0_0_8px_#fff]"></span>
                                    <span class="text-[10px] mono text-slate-300">Default</span>
                                </div>
                                <div class="mt-2">
                                    <p class="text-xs font-semibold text-white">Frosted Idle</p>
                                    <p class="text-[10px] text-slate-400">All changes saved</p>
                                </div>
                            </button>

                            <!-- Unsaved State Button -->
                            <button onclick="setWindowAura('unsaved')" id="aura-btn-unsaved"
                                class="aura-mode-btn p-2.5 rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 text-left transition flex flex-col justify-between">
                                <div class="flex items-center justify-between">
                                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_10px_#f59e0b]"></span>
                                    <span class="text-[10px] mono text-amber-300">Modified</span>
                                </div>
                                <div class="mt-2">
                                    <p class="text-xs font-semibold text-amber-200">Amber Aura</p>
                                    <p class="text-[10px] text-slate-400">Unsaved work</p>
                                </div>
                            </button>

                            <!-- Processing / Downloading State Button -->
                            <button onclick="setWindowAura('processing')" id="aura-btn-processing"
                                class="aura-mode-btn p-2.5 rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 text-left transition flex flex-col justify-between">
                                <div class="flex items-center justify-between">
                                    <span class="w-2.5 h-2.5 rounded-full bg-sky-400 shadow-[0_0_10px_#38bdf8] animate-ping"></span>
                                    <span class="text-[10px] mono text-sky-300">Active</span>
                                </div>
                                <div class="mt-2">
                                    <p class="text-xs font-semibold text-sky-200">Blue Pulse</p>
                                    <p class="text-[10px] text-slate-400">Rendering 4K...</p>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Live Document Scratchpad (Typing triggers Amber Unsaved Aura automatically!) -->
                    <div class="p-3.5 rounded-xl bg-slate-950/40 border border-white/10 flex-1 flex flex-col">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-[11px] font-medium text-slate-300 flex items-center gap-1.5">
                                <i class="ph-bold ph-note-pencil text-amber-400"></i>
                                Interactive Scratchpad (Type below to auto-trigger Amber Unsaved Aura)
                            </span>
                            <button onclick="saveScratchpad()" class="px-2 py-0.5 rounded bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/30 text-[10px] font-semibold transition">
                                Save (⌘S)
                            </button>
                        </div>
                        <textarea id="live-scratchpad" rows="2" 
                            oninput="onScratchpadInput()"
                            class="w-full flex-1 bg-slate-900/70 border border-white/10 rounded-lg p-2 text-xs text-slate-200 focus:outline-none focus:border-amber-400/50 resize-none"
                            placeholder="Type anything here... Watch the Horizon Pill at the top-center automatically glow Amber to warn of unsaved changes!"></textarea>
                    </div>
                </div>

                <!-- Right Column: Spatial Physics Map & Telemetry -->
                <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
                    
                    <!-- Spatial Gesture Compass Card -->
                    <div class="p-4 rounded-xl bg-slate-950/60 border border-white/10 flex flex-col items-center text-center">
                        <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-1">Spatial Flick Compass</h3>
                        <p class="text-[11px] text-slate-400 mb-3">Click & drag the top Horizon Pill in any direction—or click a compass node below:</p>

                        <!-- Visual 4-Way Spatial Diagram -->
                        <div class="relative w-48 h-40 flex items-center justify-center">
                            <!-- Up: Maximize -->
                            <button onclick="triggerWindowAction('toggle-maximize')" 
                                class="absolute top-0 px-3 py-1 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/30 border border-emerald-400/40 text-emerald-300 text-[11px] font-medium flex items-center gap-1 transition shadow">
                                <i class="ph-bold ph-arrow-up"></i> Flick Up: Max
                            </button>

                            <!-- Left: Snap Left -->
                            <button onclick="triggerWindowAction('snap-left')" 
                                class="absolute left-0 px-2.5 py-1.5 rounded-lg bg-sky-500/15 hover:bg-sky-500/30 border border-sky-400/40 text-sky-300 text-[11px] font-medium flex items-center gap-1 transition shadow">
                                <i class="ph-bold ph-arrow-left"></i> 50% L
                            </button>

                            <!-- Center Mini Pill Icon -->
                            <div class="w-12 h-3.5 rounded-full bg-white/30 border border-white/60 shadow-[0_0_12px_rgba(255,255,255,0.4)]"></div>

                            <!-- Right: Snap Right -->
                            <button onclick="triggerWindowAction('snap-right')" 
                                class="absolute right-0 px-2.5 py-1.5 rounded-lg bg-sky-500/15 hover:bg-sky-500/30 border border-sky-400/40 text-sky-300 text-[11px] font-medium flex items-center gap-1 transition shadow">
                                50% R <i class="ph-bold ph-arrow-right"></i>
                            </button>

                            <!-- Down: Live Pip -->
                            <button onclick="triggerWindowAction('minimize-pip')" 
                                class="absolute bottom-0 px-3 py-1 rounded-lg bg-amber-500/15 hover:bg-amber-500/30 border border-amber-400/40 text-amber-300 text-[11px] font-medium flex items-center gap-1 transition shadow">
                                <i class="ph-bold ph-arrow-down"></i> Flick Down: Pip
                            </button>
                        </div>
                    </div>

                    <!-- Time-Loop Safety Net Showcase Card -->
                    <div class="p-4 rounded-xl bg-rose-950/25 border border-rose-500/25 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-rose-300 flex items-center gap-1.5">
                                    <i class="ph-bold ph-clock-counter-clockwise"></i>
                                    Time-Loop Close Safety Net
                                </span>
