    <!-- JAVASCRIPT ENGINE FOR KINETIC MORPH PILL GESTURES & STATES -->
    <script>
        const appWindow = document.getElementById('app-window');
        const horizonPill = document.getElementById('horizon-pill');
        const horizonPillWrapper = document.getElementById('horizon-pill-wrapper');
        const snapPreviewOverlay = document.getElementById('snap-preview-overlay');
        const snapPreviewLabel = document.getElementById('snap-preview-label');
        const livePipWidget = document.getElementById('live-pip-widget');
        const undoRingContainer = document.getElementById('undo-close-ring-container');
        const undoSvgProgress = document.getElementById('undo-svg-progress');
        const undoSecondsText = document.getElementById('undo-seconds-text');
        const permanentlyClosedCard = document.getElementById('permanently-closed-card');

        const topBarModeBadge = document.getElementById('top-bar-mode-badge');
        const windowSizePill = document.getElementById('window-size-pill');
        const lastActionBadge = document.getElementById('last-action-badge');
        const dragVectorReadout = document.getElementById('drag-vector-readout');
        const gestureTelemetryText = document.getElementById('gesture-telemetry-text');

        // Window State Tracking
        let currentWindowState = 'default'; // 'default', 'maximized', 'snap-left', 'snap-right', 'pip', 'closing', 'closed'
        let currentAura = 'idle'; // 'idle', 'unsaved', 'processing'
        let currentPillCorner = 'right'; // 'right' (Windows style) or 'left' (Mac style)
        let undoInterval = null;
        let undoRemainingMs = 5000;
        let renderProgress = 64;

        // =========================================================================
        // 0. CORNER PLACEMENT SWITCHER (Top-Right vs Top-Left)
        // =========================================================================
        function setPillCorner(corner) {
            currentPillCorner = corner;
            const titlebar = document.getElementById('window-titlebar');
            const tooltip = document.getElementById('pill-micro-tooltip');
            const zoneTile = document.getElementById('pill-zone-tile');
            const zoneMorph = document.getElementById('pill-zone-morph');
            const zoneClose = document.getElementById('pill-zone-close');
            const segmentsGrid = document.getElementById('pill-segments-grid');

            const btnLeft = document.getElementById('corner-btn-left');
            const btnRight = document.getElementById('corner-btn-right');
            const panelLeft = document.getElementById('panel-corner-left');
            const panelRight = document.getElementById('panel-corner-right');
            const cornerBadge = document.getElementById('active-corner-pill-badge');
            const heroCornerText = document.getElementById('hero-corner-text');

            if (corner === 'left') {
                // Place Horizon Pill on Top-Left (Mac Style) and expand inward to the right
                titlebar.classList.add('flex-row-reverse');
                horizonPillWrapper.classList.remove('items-end');
                horizonPillWrapper.classList.add('items-start');
                tooltip.classList.remove('right-0');
                tooltip.classList.add('left-0');

                // Put Close button on the far-left outer corner edge for true Fitts's Law ergonomics
                segmentsGrid.innerHTML = '';
                zoneClose.className = 'h-full w-full flex items-center justify-center gap-1 bg-rose-500/20 hover:bg-rose-600 text-rose-200 hover:text-white transition-all duration-150 px-2 border-r border-white/10 group/close';
                zoneMorph.className = 'h-full flex items-center justify-center gap-1.5 hover:bg-white/10 transition-colors border-r border-white/10 px-1.5';
                zoneTile.className = 'h-full flex items-center justify-center gap-1 hover:bg-white/10 transition-colors px-1.5';
                segmentsGrid.appendChild(zoneClose);
                segmentsGrid.appendChild(zoneMorph);
                segmentsGrid.appendChild(zoneTile);

                // Update active button styles
                btnLeft.className = 'px-2 py-0.5 rounded-md bg-sky-500/25 text-sky-300 border border-sky-400/30 font-semibold transition flex items-center gap-1';
                btnRight.className = 'px-2 py-0.5 rounded-md text-slate-400 hover:text-white transition flex items-center gap-1';
                panelLeft.className = 'py-1.5 px-2 rounded-lg bg-sky-500/20 border border-sky-400/40 text-[11px] font-semibold text-sky-200 flex items-center justify-center gap-1.5 transition';
                panelRight.className = 'py-1.5 px-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] font-medium text-slate-300 flex items-center justify-center gap-1.5 transition';

                cornerBadge.textContent = 'Top-Left Corner';
                heroCornerText.textContent = 'top-left corner';
                updateTelemetry('Shifted Horizon Pill to Top-Left Corner (Mac Ergonomic Style)');
            } else {
                // Place Horizon Pill on Top-Right (Windows Style) and expand inward to the left
                titlebar.classList.remove('flex-row-reverse');
                horizonPillWrapper.classList.remove('items-start');
                horizonPillWrapper.classList.add('items-end');
                tooltip.classList.remove('left-0');
                tooltip.classList.add('right-0');

                // Put Close button on the far-right outer corner edge
                segmentsGrid.innerHTML = '';
                zoneTile.className = 'h-full flex items-center justify-center gap-1 hover:bg-white/10 transition-colors border-r border-white/10 px-1.5';
                zoneMorph.className = 'h-full flex items-center justify-center gap-1.5 hover:bg-white/10 transition-colors border-r border-white/10 px-1.5';
                zoneClose.className = 'h-full w-full flex items-center justify-center gap-1 bg-rose-500/20 hover:bg-rose-600 text-rose-200 hover:text-white transition-all duration-150 px-2 group/close';
                segmentsGrid.appendChild(zoneTile);
                segmentsGrid.appendChild(zoneMorph);
                segmentsGrid.appendChild(zoneClose);

                // Update active button styles
                btnRight.className = 'px-2 py-0.5 rounded-md bg-sky-500/25 text-sky-300 border border-sky-400/30 font-semibold transition flex items-center gap-1';
                btnLeft.className = 'px-2 py-0.5 rounded-md text-slate-400 hover:text-white transition flex items-center gap-1';
                panelRight.className = 'py-1.5 px-2 rounded-lg bg-sky-500/20 border border-sky-400/40 text-[11px] font-semibold text-sky-200 flex items-center justify-center gap-1.5 transition';
                panelLeft.className = 'py-1.5 px-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] font-medium text-slate-300 flex items-center justify-center gap-1.5 transition';

                cornerBadge.textContent = 'Top-Right Corner';
                heroCornerText.textContent = 'top-right corner';
                updateTelemetry('Shifted Horizon Pill to Top-Right Corner (Windows Ergonomic Style)');
            }
        }

        // Live Clock
        function updateClock() {
            const now = new Date();
            document.getElementById('system-clock').textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
        setInterval(updateClock, 10000);
        updateClock();

        // Simulated Background Render Progress for Live Pip & Processing Aura
        setInterval(() => {
            renderProgress = (renderProgress + 1) % 101;
            if (renderProgress < 15) renderProgress = 18;
            document.getElementById('pip-progress-text').textContent = renderProgress + '%';
            document.getElementById('pip-progress-bar').style.width = renderProgress + '%';
            document.querySelectorAll('.render-pct').forEach(el => el.textContent = renderProgress + '%');
        }, 900);

        // =========================================================================
        // 1. STATUS AURA SWITCHER (Idle White, Unsaved Amber, Processing Blue)
        // =========================================================================
        function setWindowAura(mode) {
            currentAura = mode;
            horizonPill.classList.remove('aura-idle', 'aura-unsaved', 'aura-processing');
            
            const unsavedBadge = document.getElementById('unsaved-badge');
            const renderBadge = document.getElementById('render-badge');
            const auraTopDot = document.getElementById('aura-top-dot');
            const auraTopLabel = document.getElementById('aura-top-label');

            // Reset button highlights
            document.querySelectorAll('.aura-mode-btn').forEach(btn => {
                btn.classList.remove('border-white/40', 'bg-white/15', 'border-amber-400/60', 'bg-amber-500/15', 'border-sky-400/60', 'bg-sky-500/15');
                btn.classList.add('border-white/10', 'bg-white/5');
            });

            if (mode === 'idle') {
                horizonPill.classList.add('aura-idle');
                unsavedBadge.classList.add('hidden');
                renderBadge.classList.add('hidden');
                auraTopDot.className = 'w-2 h-2 rounded-full bg-white shadow-[0_0_6px_#fff]';
                auraTopLabel.textContent = 'Aura: Frosted Idle';
                document.getElementById('aura-btn-idle').classList.add('border-white/40', 'bg-white/15');
                updateTelemetry('Aura set to Frosted White (Idle / Saved)');
            } else if (mode === 'unsaved') {
                horizonPill.classList.add('aura-unsaved');
                unsavedBadge.classList.remove('hidden');
                renderBadge.classList.add('hidden');
                auraTopDot.className = 'w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_#f59e0b]';
                auraTopLabel.textContent = 'Aura: Unsaved Changes';
                document.getElementById('aura-btn-unsaved').classList.add('border-amber-400/60', 'bg-amber-500/15');
                updateTelemetry('Aura glowing Amber — Unsaved edits detected');
            } else if (mode === 'processing') {
                horizonPill.classList.add('aura-processing');
                unsavedBadge.classList.add('hidden');
                renderBadge.classList.remove('hidden');
                auraTopDot.className = 'w-2 h-2 rounded-full bg-sky-400 animate-ping';
                auraTopLabel.textContent = 'Aura: Background Task';
                document.getElementById('aura-btn-processing').classList.add('border-sky-400/60', 'bg-sky-500/15');
                updateTelemetry('Aura pulsing Sky Blue — Background render active');
            }
        }

        function onScratchpadInput() {
            if (currentAura !== 'unsaved') {
                setWindowAura('unsaved');
            }
        }

        function saveScratchpad() {
            setWindowAura('idle');
            updateTelemetry('Document saved! Horizon Pill returned to calm Frosted White.');
        }

        // =========================================================================
        // 2. WINDOW GEOMETRY & SPATIAL ACTIONS
        // =========================================================================
        function getCenteredGeometry() {
            const stage = document.getElementById('desktop-stage');
            const sw = stage.clientWidth;
            const sh = stage.clientHeight;
            const isXL = window.innerWidth >= 1280;
            const w = Math.min(780, sw - (isXL ? 340 : 32));
            const h = Math.min(510, sh - 40);
            const left = isXL ? Math.max(24, (sw - 300 - w) / 2) : Math.max(16, (sw - w) / 2);
            const top = Math.max(16, (sh - h) / 2);
            return { w, h, top, left };
        }

        function applyCenteredGeometry() {
            const g = getCenteredGeometry();
            appWindow.style.width = g.w + 'px';
            appWindow.style.height = g.h + 'px';
            appWindow.style.top = g.top + 'px';
            appWindow.style.left = g.left + 'px';
            appWindow.style.borderRadius = '18px';
            appWindow.style.transform = 'scale(1) translate(0px, 0px)';
            appWindow.style.opacity = '1';
            appWindow.style.pointerEvents = 'auto';
        }

        function triggerWindowAction(action) {
            // Clear any active Time-Loop Undo countdown if user interacts
            if (currentWindowState === 'closing' || currentWindowState === 'closed') {
                clearUndoCountdown();
                permanentlyClosedCard.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
            }

            // Hide Live Pip if restoring
            if (currentWindowState === 'pip' && action !== 'minimize-pip') {
                livePipWidget.classList.add('opacity-0', 'translate-y-8', 'scale-90', 'pointer-events-none');
            }

            const stage = document.getElementById('desktop-stage');
            const sw = stage.clientWidth;
            const sh = stage.clientHeight;

            if (action === 'toggle-maximize') {
                if (currentWindowState === 'maximized') {
                    triggerWindowAction('reset-center');
                    return;
                }
                currentWindowState = 'maximized';
                appWindow.style.width = (sw - 16) + 'px';
                appWindow.style.height = (sh - 16) + 'px';
                appWindow.style.top = '8px';
                appWindow.style.left = '8px';
                appWindow.style.borderRadius = '14px';
                appWindow.style.transform = 'scale(1) translate(0px, 0px)';
                appWindow.style.opacity = '1';
                appWindow.style.pointerEvents = 'auto';

                topBarModeBadge.textContent = 'State: Fullscreen Maximized';
                windowSizePill.textContent = '100% Fullscreen';
                updateTelemetry('Flick Up ↑ — Maximized Window');
            } 
            else if (action === 'snap-left') {
                currentWindowState = 'snap-left';
                appWindow.style.width = (Math.floor(sw / 2) - 12) + 'px';
                appWindow.style.height = (sh - 16) + 'px';
                appWindow.style.top = '8px';
                appWindow.style.left = '8px';
                appWindow.style.borderRadius = '16px';
                appWindow.style.transform = 'scale(1) translate(0px, 0px)';
                appWindow.style.opacity = '1';
                appWindow.style.pointerEvents = 'auto';

                topBarModeBadge.textContent = 'State: Left 50% Split';
                windowSizePill.textContent = 'Left 50% Tile';
                updateTelemetry('Dragged Left ← — Snapped to Left 50%');
            } 
            else if (action === 'snap-right') {
                currentWindowState = 'snap-right';
                const halfW = Math.floor(sw / 2) - 12;
                appWindow.style.width = halfW + 'px';
                appWindow.style.height = (sh - 16) + 'px';
                appWindow.style.top = '8px';
                appWindow.style.left = (sw - halfW - 8) + 'px';
                appWindow.style.borderRadius = '16px';
                appWindow.style.transform = 'scale(1) translate(0px, 0px)';
                appWindow.style.opacity = '1';
                appWindow.style.pointerEvents = 'auto';

                topBarModeBadge.textContent = 'State: Right 50% Split';
                windowSizePill.textContent = 'Right 50% Tile';
                updateTelemetry('Dragged Right → — Snapped to Right 50%');
            } 
            else if (action === 'minimize-pip') {
                currentWindowState = 'pip';
                appWindow.style.transform = 'translate(-260px, 240px) scale(0.18)';
                appWindow.style.opacity = '0';
                appWindow.style.pointerEvents = 'none';

                livePipWidget.classList.remove('opacity-0', 'translate-y-8', 'scale-90', 'pointer-events-none');
                topBarModeBadge.textContent = 'State: Live Pip Minimized';
                updateTelemetry('Flick Down ↓ — Folded into Live Pip Widget');
            } 
            else if (action === 'close-window') {
                startUndoCloseSequence();
            } 
            else {
                currentWindowState = 'default';
                applyCenteredGeometry();
                topBarModeBadge.textContent = 'State: Centered Window';
                windowSizePill.textContent = 'Default View';
                updateTelemetry('Restored to Default Centered Window');
            }
        }

        function cycleSnapSplit() {
            if (currentWindowState === 'snap-left') {
                triggerWindowAction('snap-right');
            } else {
                triggerWindowAction('snap-left');
            }
        }

        function restoreFromPip() {
            livePipWidget.classList.add('opacity-0', 'translate-y-8', 'scale-90', 'pointer-events-none');
            triggerWindowAction('reset-center');
            updateTelemetry('Expanded Live Pip back to full Studio Window');
        }

        // =========================================================================
        // 3. THE 5-SECOND "TIME-LOOP" UNDO CLOSE SAFETY NET
        // =========================================================================
        function startUndoCloseSequence() {
            clearUndoCountdown();
            currentWindowState = 'closing';

            // Morph window upward into the top-center countdown ring
            appWindow.style.transform = 'translateY(-220px) scale(0.12)';
            appWindow.style.opacity = '0';
            appWindow.style.pointerEvents = 'none';
            livePipWidget.classList.add('opacity-0', 'translate-y-8', 'scale-90', 'pointer-events-none');

            // Reveal 5-second Time-Loop Ring
            undoRingContainer.classList.remove('opacity-0', '-translate-y-6', 'scale-90', 'pointer-events-none');
            topBarModeBadge.textContent = 'State: Time-Loop Ghost (5s Undo)';
            updateTelemetry('Window Closed — 5-Second Time-Loop Safety Ring Active');

            const totalMs = 5000;
            undoRemainingMs = totalMs;
            const circumference = 100.53;

            undoInterval = setInterval(() => {
                undoRemainingMs -= 50;
                if (undoRemainingMs <= 0) {
                    clearUndoCountdown();
                    finalizePermanentClose();
                } else {
                    const sec = (undoRemainingMs / 1000).toFixed(1);
                    undoSecondsText.textContent = sec;
                    const offset = circumference * (1 - undoRemainingMs / totalMs);
                    undoSvgProgress.style.strokeDashoffset = offset;
                }
            }, 50);
        }

        function clearUndoCountdown() {
            if (undoInterval) {
                clearInterval(undoInterval);
                undoInterval = null;
            }
            undoRingContainer.classList.add('opacity-0', '-translate-y-6', 'scale-90', 'pointer-events-none');
            undoSvgProgress.style.strokeDashoffset = '0';
        }

        function undoCloseWindow() {
            clearUndoCountdown();
            triggerWindowAction('reset-center');
            updateTelemetry('Time-Loop Reversed! Window sprang back open with zero data loss.');
        }

        function finalizePermanentClose() {
            currentWindowState = 'closed';
            topBarModeBadge.textContent = 'State: Closed';
            permanentlyClosedCard.classList.remove('opacity-0', 'scale-90', 'pointer-events-none');
            updateTelemetry('5s Countdown Completed — Window Closed Cleanly');
        }

        function relaunchWindow() {
            clearUndoCountdown();
            permanentlyClosedCard.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
            livePipWidget.classList.add('opacity-0', 'translate-y-8', 'scale-90', 'pointer-events-none');
            triggerWindowAction('reset-center');
        }

        // =========================================================================
        // 4. DIRECT DRAG & FLICK PHYSICS ON THE KINETIC MORPH PILL
        // =========================================================================
        let isDraggingPill = false;
        let dragStartX = 0;
        let dragStartY = 0;
        let pendingGestureAction = null;

        horizonPillWrapper.addEventListener('pointerdown', (e) => {
            // Middle-Click anywhere on the pill triggers instant Close with Undo Ring
            if (e.button === 1) {
                e.preventDefault();
                triggerWindowAction('close-window');
                return;
            }
            // Ignore if clicking directly on an inner action button
            if (e.target.closest('button')) return;

            isDraggingPill = true;
            dragStartX = e.clientX;
            dragStartY = e.clientY;
            pendingGestureAction = null;

            horizonPill.classList.add('pill-active');
            appWindow.classList.add('dragging-pill');
            horizonPillWrapper.setPointerCapture(e.pointerId);
        });

        horizonPillWrapper.addEventListener('pointermove', (e) => {
            if (!isDraggingPill) return;

            const dx = e.clientX - dragStartX;
            const dy = e.clientY - dragStartY;
            dragVectorReadout.textContent = `Δx: ${Math.round(dx)}px, Δy: ${Math.round(dy)}px`;

            // Elastic feedback on window and pill
            const clampedX = Math.max(-75, Math.min(75, dx * 0.35));
            const clampedY = Math.max(-55, Math.min(55, dy * 0.35));
            appWindow.style.transform = `translate(${clampedX}px, ${clampedY}px)`;

            // Determine Spatial Gesture Zone
            const stage = document.getElementById('desktop-stage');
            const sw = stage.clientWidth;
            const sh = stage.clientHeight;

            if (dy < -42 && Math.abs(dy) > Math.abs(dx)) {
                pendingGestureAction = 'toggle-maximize';
                showSnapPreview(8, 8, sw - 16, sh - 16, 'Release to Maximize Fullscreen ↑');
            } else if (dy > 48 && Math.abs(dy) > Math.abs(dx)) {
                pendingGestureAction = 'minimize-pip';
                showSnapPreview(24, sh - 160, 280, 125, 'Release to Fold into Live Pip ↓');
            } else if (dx < -55 && Math.abs(dx) >= Math.abs(dy)) {
                pendingGestureAction = 'snap-left';
                showSnapPreview(8, 8, Math.floor(sw / 2) - 12, sh - 16, 'Release to Tile Left 50% ←');
            } else if (dx > 55 && Math.abs(dx) >= Math.abs(dy)) {
                pendingGestureAction = 'snap-right';
                const halfW = Math.floor(sw / 2) - 12;
                showSnapPreview(sw - halfW - 8, 8, halfW, sh - 16, 'Release to Tile Right 50% →');
            } else {
                pendingGestureAction = null;
                hideSnapPreview();
            }
        });

        horizonPillWrapper.addEventListener('pointerup', (e) => {
            if (!isDraggingPill) return;
            isDraggingPill = false;
            horizonPill.classList.remove('pill-active');
            appWindow.classList.remove('dragging-pill');
            hideSnapPreview();

            if (pendingGestureAction) {
                triggerWindowAction(pendingGestureAction);
            } else {
                appWindow.style.transform = 'translate(0px, 0px)';
            }
            pendingGestureAction = null;
        });

        function showSnapPreview(left, top, width, height, label) {
            snapPreviewOverlay.style.left = left + 'px';
            snapPreviewOverlay.style.top = top + 'px';
            snapPreviewOverlay.style.width = width + 'px';
            snapPreviewOverlay.style.height = height + 'px';
            snapPreviewOverlay.style.opacity = '1';
            snapPreviewLabel.textContent = label;
        }

        function hideSnapPreview() {
            snapPreviewOverlay.style.opacity = '0';
        }

        function triggerDemoHoverWake() {
            horizonPill.classList.toggle('pill-active');
            const isAwake = horizonPill.classList.contains('pill-active');
            updateTelemetry(isAwake ? 'Horizon Pill locked in Expanded Wake-Up state' : 'Horizon Pill returned to Resting Capsule');
        }

        function updateTelemetry(message) {
            lastActionBadge.textContent = message;
            if (gestureTelemetryText) {
                gestureTelemetryText.textContent = message;
            }
        }

        // Responsive Window Recalculation on Resize
        window.addEventListener('resize', () => {
            if (currentWindowState === 'default') {
                applyCenteredGeometry();
            } else if (currentWindowState === 'maximized') {
                triggerWindowAction('toggle-maximize');
            } else if (currentWindowState === 'snap-left' || currentWindowState === 'snap-right') {
                triggerWindowAction(currentWindowState);
            }
        });

        // Initialize Default Centered Geometry on Load
        window.addEventListener('DOMContentLoaded', () => {
            applyCenteredGeometry();
        });
    </script>
</body>
</html>
